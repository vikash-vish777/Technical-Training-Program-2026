class stack:
    def __init__(self, stack_size):
        self.stack_size = stack_size
        self.stackList = []

    def isfull(self):
        return len(self.stackList) == self.stack_size

    def isempty(self):
        return self.stackList == []

    def push(self, data):
        if self.isfull():
            print("Stack is full")
        else:
            self.stackList.append(data)
            print("Data pushed to stack")

    def pop(self):
        if self.isempty():
            print("Stack is empty")
        else:
            data = self.stackList.pop()
            print("Data popped from stack:", data)

    def peek(self):
        if self.isempty():
            print("Stack is empty")
        else:
            print("Top element of stack:", self.stackList[-1])

    def deletestack(self):
        self.stackList = []
        print("Stack deleted")

    def display(self):
        print("Stack elements:", self.stackList)

size = int(input("Enter the size of stack: "))
objstack = stack(size)

while True:
    print("1.push element")
    print("2.pop element")
    print("3.peek element")
    print("4.isempty")
    print("5.isfull")
    print("6.display")
    print("7.delete stack")
    print("8.exit")
    choice = int(input("Enter your choice: "))

    if choice == 1:
        data = int(input("Enter data to push: "))
        objstack.push(data)
    elif choice == 2:
        objstack.pop()
    elif choice == 3:
        objstack.peek()
    elif choice == 4:
        if objstack.isempty():
            print("Stack is empty")
        else:
            print("Stack is not empty")
    elif choice == 5:
        if objstack.isfull():
            print("Stack is full")
        else:
            print("Stack is not full")
    elif choice == 6:
        objstack.display()
    elif choice == 7:
        objstack.deletestack()
    elif choice == 8:
        break
    else:
        print("Invalid choice")

def isfull(self):
    if len(self.stackList) == self.stack_size:
        return True
    else:
        return False

def isempty(self):
    if self.stackList == []:
        return True
    else:
        return False

def push(self, data):
    if self.isfull():
        print("Stack is full")
    else:
        self.stackList.append(data)
        print("Data pushed to stack")

def pop(self):
    if self.isempty():
        print("Stack is empty")
    else:
        data = self.stackList.pop()
        print("Data popped from stack:", data)

def peek(self):
    if self.isempty():
        print("Stack is empty")
    else:
        data = self.stackList[-1]
        print("Top element of stack:", data)


def deletestack(self):
    if self.isempty():
        print("Stack is already empty")
    else:
        self.stackList = None
        print("Stack deleted")


def display(self):
    print("Stack elements:", self.stackList)






